<article class="product-card"><a class="product-visual" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: widths: '300,500,800', sizes: '(min-width: 1000px) 350px, 85vw', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'product-placeholder' }}{% endif %}</a><div class="product-copy"><p class="eyebrow">{{ product.type | escape }}</p><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>{% if product.metafields.custom.subtitle != blank %}<p>{{ product.metafields.custom.subtitle.value | escape }}</p>{% endif %}<div class="price">{% if product.price_varies %}Desde {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>{% unless product.available %}<p class="stock-label">Agotado</p>{% endunless %}<a class="btn small" href="{{ product.url }}">Ver producto</a></div></article>

<form method="get" class="filters">{% if results.terms %}<input type="hidden" name="q" value="{{ results.terms | escape }}"><input type="hidden" name="type" value="product">{% endif %}{% for filter in results.filters %}<details class="filter"><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary><div class="filter-content">{% case filter.type %}{% when 'list', 'boolean' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% elsif value.count == 0 %}disabled{% endif %}> {{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>Desde ({{ cart.currency.iso_code }})<input name="{{ filter.min_value.param_name }}" type="number" min="0" step="0.01" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>Hasta ({{ cart.currency.iso_code }})<input name="{{ filter.max_value.param_name }}" type="number" min="0" step="0.01" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>{% endcase %}</div></details>{% endfor %}<label class="sort-label">Ordenar<select name="sort_by">{% assign sort = results.sort_by | default: results.default_sort_by %}{% for option in results.sort_options %}<option value="{{ option.value }}" {% if option.value == sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label><button class="btn small" type="submit">Aplicar</button><a class="text-link" href="{% if results.terms %}{{ routes.search_url }}?type=product&q={{ results.terms | url_encode }}{% else %}{{ results.url }}{% endif %}">Limpiar filtros</a></form><div class="active-filters">{% for filter in results.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value or filter.max_value.value %}<a href="{{ filter.url_to_remove }}">Quitar rango de precio ×</a>{% endif %}{% endif %}{% endfor %}</div>

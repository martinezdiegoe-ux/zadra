<section class="section surface" id="coleccion"><div class="shell"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.title | escape }}</h2></div><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">Ver colección <span aria-hidden="true">↗</span></a></div><div class="rail" data-rail id="Rail-{{ section.id }}">{% for product in section.settings.collection.products limit: 8 %}{% render 'product-card', product: product %}{% else %}{% for i in (1..3) %}<article class="product-card placeholder-card"><div class="product-visual">{{ 'object-' | append: i | append: '.svg' | asset_url | image_tag: width: 600, height: 440, loading: 'lazy', alt: 'Ilustración conceptual' }}</div><div class="product-copy"><p class="eyebrow">Vista de ejemplo</p><h3>Tu próxima elección.</h3><p>El catálogo está en preparación.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Explorar zadra ↗</a></div></article>{% endfor %}{% endfor %}</div><div class="rail-controls"><button class="round-button" data-scroll="-1" data-target="Rail-{{ section.id }}" aria-label="Productos anteriores">←</button><button class="round-button" data-scroll="1" data-target="Rail-{{ section.id }}" aria-label="Productos siguientes">→</button></div></div></section>
{% schema %}
{
  "name": "Productos destacados",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Antetítulo",
      "default": "Elegidos para descubrir"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Encontrá tu próximo favorito."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    }
  ],
  "presets": [
    {
      "name": "Productos destacados"
    }
  ]
}
{% endschema %}

<section class="section shell"><div class="section-heading"><h2>{{ section.settings.title | escape }}</h2></div><div class="editorial-grid">{% for block in section.blocks %}<article class="editorial-card {% if block.settings.dark %}dark{% endif %}" {{ block.shopify_attributes }}><div class="editorial-copy"><p class="eyebrow">{{ block.settings.kicker | escape }}</p><h3>{{ block.settings.heading | escape | newline_to_br }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_text | escape }} ↗</a>{% endif %}</div>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 | image_tag: widths: '500,800,1200', loading: 'lazy', sizes: '(min-width: 800px) 45vw, 90vw', class: 'editorial-image' }}{% else %}{{ 'editorial-' | append: forloop.index | append: '.svg' | asset_url | image_tag: width: 800, height: 750, loading: 'lazy', alt: '', class: 'editorial-image' }}{% endif %}</article>{% endfor %}</div></section>
{% schema %}
{
  "name": "Historias zadra",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Hay mucho por descubrir."
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Historia",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Antetítulo",
          "default": "La experiencia zadra"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Título",
          "default": "Todo empieza\ncon los detalles."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Una mirada distinta a lo cotidiano."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "checkbox",
          "id": "dark",
          "label": "Fondo oscuro",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Texto del enlace",
          "default": "Descubrir"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Historias zadra"
    }
  ]
}
{% endschema %}

<section class="shell section cart-page"><p class="eyebrow">Tu selección</p><h1>Tu bolsa.</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" class="cart-form"><div class="cart-items">{% for item in cart.items %}<article class="cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 320 | image_tag: widths: '160,320', sizes: '120px', loading: 'lazy' }}</a>{% endif %}<div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% for property in item.properties %}{% assign first_char = property.first | slice: 0 %}{% unless property.last == blank or first_char == '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endunless %}{% endfor %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}<label for="CartQty-{{ forloop.index }}">Cantidad</label><input id="CartQty-{{ forloop.index }}" name="updates[]" type="number" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}" {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %} value="{{ item.quantity }}"><a class="text-link" href="{{ item.url_to_remove }}">Eliminar</a>{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}</div><div><strong>{{ item.final_line_price | money }}</strong>{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}{% if item.unit_price_measurement %}<p>{{ item.unit_price | money }} / {{ item.unit_price_measurement.reference_value }}{{ item.unit_price_measurement.reference_unit }}</p>{% endif %}</div></article>{% endfor %}</div><div class="cart-bottom"><label for="CartNote">Nota del pedido</label><textarea id="CartNote" name="note">{{ cart.note | escape }}</textarea>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<h2>Total: {{ cart.total_price | money }}</h2><p>{% if cart.taxes_included %}Impuestos incluidos. {% endif %}Envío y descuentos finales calculados en el checkout.</p><button class="btn secondary" type="submit" name="update">Actualizar bolsa</button><button class="btn" type="submit" name="checkout">Finalizar compra</button><p class="muted">Continuás al checkout seguro de Shopify.</p></div></form>{% else %}<div class="empty-state"><h2>Hay lugar para algo especial.</h2><p>Tu bolsa está vacía.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Explorar productos</a></div>{% endif %}</section>
{% schema %}
{
  "name": "Bolsa zadra",
  "settings": []
}
{% endschema %}

<section class="shell section"><h1>El universo zadra.</h1><div class="catalog-grid">{% paginate collections by 24 %}{% for collection in collections %}<article class="product-card"><a class="product-visual" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,800', sizes: '(min-width: 800px) 30vw, 90vw' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</a><div class="product-copy"><h2><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2><a class="text-link" href="{{ collection.url }}">Explorar ↗</a></div></article>{% else %}<p>Las colecciones estarán disponibles próximamente.</p>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}</div></section>
{% schema %}
{
  "name": "Colecciones zadra",
  "settings": []
}
{% endschema %}

<section class="shell section"><div class="section-heading"><div><p class="eyebrow">El catálogo zadra</p><h1>{{ collection.title | escape }}</h1></div><a class="text-link" href="{{ collection.url }}?view=compare">Comparar esta colección ↗</a></div>{% if collection.description != blank %}<div class="rte collection-description">{{ collection.description }}</div>{% endif %}{% render 'filters', results: collection %}{% paginate collection.products by 24 %}<p class="muted">{{ collection.products_count }} productos</p><div class="catalog-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="empty-state"><h2>No hay productos para mostrar.</h2><p>Probá con otros filtros o volvé más adelante.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Ver todos los productos ↗</a></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}
{
  "name": "Catálogo zadra",
  "settings": []
}
{% endschema %}

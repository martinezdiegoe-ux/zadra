<section class="shell section prose"><h1>{{ page.title | escape }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact' %}{% if form.posted_successfully? %}<p role="status">Recibimos tu mensaje. Gracias por escribirnos.</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">Nombre</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required><label for="ContactEmail">Correo electrónico</label><input id="ContactEmail" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required><label for="ContactBody">Mensaje</label><textarea id="ContactBody" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea><button class="btn" type="submit">Enviar mensaje</button>{% endform %}<p><a class="text-link" href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a></p></section>
{% schema %}
{
  "name": "Contacto zadra",
  "settings": []
}
{% endschema %}

<section class="intro shell"><div class="intro-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1></div><p class="intro-aside">{{ section.settings.subheading | escape }}</p></div>
<nav class="category-rail" aria-label="Categorías">{% for block in section.blocks %}<a class="category-tile" href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span class="category-image">{% if block.settings.image %}{{ block.settings.image | image_url: width: 240 | image_tag: widths: '120,240', sizes: '100px', loading: 'lazy', alt: block.settings.title }}{% else %}{{ 'object-' | append: block.settings.art | append: '.svg' | asset_url | image_tag: width: 120, height: 80, loading: 'lazy', alt: '' }}{% endif %}</span><span>{{ block.settings.title | escape }}</span></a>{% endfor %}<a class="category-tile" href="#comparar"><span class="category-image compare-symbol" aria-hidden="true">▥</span><span>Comparar</span></a></nav></section>
<section class="hero shell"><div class="hero-feature">{% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 2200 | image_tag: widths: '640,960,1440,2200', sizes: '(min-width: 1200px) 1200px, 92vw', loading: 'eager', fetchpriority: 'high', class: 'hero-photo' }}{% else %}{{ 'hero-zadra.svg' | asset_url | image_tag: width: 1600, height: 800, loading: 'eager', fetchpriority: 'high', class: 'hero-photo', alt: 'Composición conceptual original de dispositivos tecnológicos' }}{% endif %}<div class="hero-copy"><p class="eyebrow">{{ section.settings.hero_kicker | escape }}</p><h2>{{ section.settings.hero_title | escape | newline_to_br }}</h2><p>{{ section.settings.hero_text | escape }}</p><a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_text | escape }}</a></div>{% unless section.settings.hero_image %}<small class="concept-label">Ilustración conceptual · no representa productos a la venta</small>{% endunless %}</div></section>
{% schema %}
{
  "name": "Presentación zadra",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "El universo zadra"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lo extraordinario, cada día."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Una nueva perspectiva.\nTu próxima elección."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Fotografía principal"
    },
    {
      "type": "text",
      "id": "hero_kicker",
      "label": "Antetítulo visual",
      "default": "Diseño en cada detalle"
    },
    {
      "type": "textarea",
      "id": "hero_title",
      "label": "Titular visual",
      "default": "Menos ruido.\nMás posibilidades."
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Descripción visual",
      "default": "Descubrí una forma más simple de elegir."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Botón",
      "default": "Explorar zadra"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Destino"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre",
          "default": "Tecnología"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "select",
          "id": "art",
          "label": "Ilustración conceptual",
          "options": [
            {
              "value": "laptop",
              "label": "laptop"
            },
            {
              "value": "audio",
              "label": "audio"
            },
            {
              "value": "watch",
              "label": "watch"
            },
            {
              "value": "display",
              "label": "display"
            }
          ],
          "default": "laptop"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Presentación zadra"
    }
  ]
}
{% endschema %}

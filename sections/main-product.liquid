{% assign current = product.selected_or_first_available_variant %}
<section class="shell section product-detail"><div class="product-gallery"><div class="main-media" id="Media-{{ section.id }}">{% if current.featured_image or product.featured_image %}{% assign primary_image = current.featured_image | default: product.featured_image %}{{ primary_image | image_url: width: 1600 | image_tag: widths: '500,800,1200,1600', sizes: '(min-width: 900px) 55vw, 92vw', loading: 'eager', fetchpriority: 'high', id: 'ProductImage' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><div class="gallery-thumbs">{% for media in product.media %}{% case media.media_type %}{% when 'image' %}<a href="{{ media | image_url: width: 1800 }}" data-gallery-image="{{ media | image_url: width: 1600 }}" data-gallery-alt="{{ media.alt | escape }}" aria-label="Ver imagen {{ forloop.index }}">{{ media | image_url: width: 160 | image_tag: width: 80, height: 80, loading: 'lazy' }}</a>{% when 'video' %}{{ media | video_tag: controls: true, preload: 'none', image_size: '500x' }}{% when 'external_video' %}{{ media | external_video_tag: loading: 'lazy' }}{% when 'model' %}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}{% endcase %}{% endfor %}</div></div>
<div class="product-info"><nav class="breadcrumbs" aria-label="Ruta"><a href="{{ routes.root_url }}">Inicio</a> / <a href="{{ routes.all_products_collection_url }}">Productos</a></nav><p class="eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1>{% if product.metafields.custom.subtitle %}<p class="lead">{{ product.metafields.custom.subtitle.value | escape }}</p>{% endif %}<div class="price" data-product-price>{{ current.price | money }}</div><s data-compare-price {% unless current.compare_at_price > current.price %}hidden{% endunless %}>{{ current.compare_at_price | money }}</s><p class="stock-label" data-stock>{% if current.available %}Disponible{% else %}Agotado{% endif %}</p>
{% form 'product', product, id: 'ProductForm', class: 'product-form' %}{{ form.errors | default_errors }}<label for="Variant-{{ section.id }}">{% if product.has_only_default_variant %}Presentación{% else %}Elegí tu variante{% endif %}</label><select name="id" id="Variant-{{ section.id }}" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if current.id == variant.id %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} · Agotado{% endunless %}</option>{% endfor %}</select>
<label for="Quantity-{{ section.id }}">Cantidad</label><input id="Quantity-{{ section.id }}" name="quantity" type="number" min="{{ current.quantity_rule.min | default: 1 }}" step="{{ current.quantity_rule.increment | default: 1 }}" {% if current.quantity_rule.max %}max="{{ current.quantity_rule.max }}"{% endif %} value="{{ current.quantity_rule.min | default: 1 }}"><button class="btn" name="add" type="submit" data-add-to-cart {% unless current.available %}disabled{% endunless %}>{% if current.available %}Agregar a la bolsa{% else %}Agotado{% endif %}</button><p class="form-feedback" role="status" aria-live="polite"></p><a class="text-link" href="{{ routes.cart_url }}">Ver mi bolsa ↗</a>{% endform %}
<script type="application/json" data-variants>[{% for variant in product.variants %}{"id":{{ variant.id | json }},"price":{{ variant.price | money | json }},"compare":{{ variant.compare_at_price | money | json }},"sale":{% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},"available":{{ variant.available | json }},"image":{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1600 | json }}{% else %}null{% endif %},"min":{{ variant.quantity_rule.min | default: 1 | json }},"step":{{ variant.quantity_rule.increment | default: 1 | json }},"max":{% if variant.quantity_rule.max %}{{ variant.quantity_rule.max | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
<details class="product-description" open><summary>Descripción y características</summary><div class="rte">{{ product.description }}</div></details>{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% endcase %}{% endfor %}</div></section><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Producto zadra",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
